# PrismAPI enterprise image — HTTP API + optional gRPC wrapper sidecar pattern.
FROM python:3.12-slim

WORKDIR /app

RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    && rm -rf /var/lib/apt/lists/*

COPY pyproject.toml README.md ./
COPY prism ./prism
COPY examples ./examples
COPY proto ./proto
COPY scripts ./scripts

RUN pip install --no-cache-dir -e ".[enterprise,cache,fabric,wrapper]"

ENV PRISM_HTTP_HOST=0.0.0.0
ENV PRISM_HTTP_PORT=9100
ENV PRISM_TENANT_ID=production
ENV PRISM_API_REQUIRE_AUTH=true

EXPOSE 9100 50051

HEALTHCHECK --interval=30s --timeout=5s --start-period=20s --retries=3 \
    CMD python -c "import urllib.request; urllib.request.urlopen('http://127.0.0.1:9100/health')"

CMD ["python", "examples/enterprise_server.py", "--host", "0.0.0.0", "--port", "9100"]
